<div class="account-wrapper">
  <h1><%= title %></h1>

  <% if (flash && flash.notice && flash.notice.length > 0) { %>
  <div class="flash"><%= flash.notice[0] %></div>
  <% } %> 
  <% if (errors) { %>
  <ul class="notice">
    <% errors.array().forEach(error => { %>
    <li class="data-error-message"><%= error.msg %></li>
    <% }) %>
  </ul>
  <% } %>

  <form action="/account/register" method="POST">
    <label for="first_name">First Name:</label>
    <input
      type="text"
      id="first_name"
      name="account_firstname"
      required
      value="<%= typeof first_name !== 'undefined' ? first_name : '' %>"
    />

    <label for="last_name">Last Name:</label>
    <input
      type="text"
      id="last_name"
      name="account_lastname"
      required
      value="<%= typeof last_name !== 'undefined' ? last_name : '' %>"
    />

    <label for="email">Email Address:</label>
    <input
      type="email"
      id="email"
      name="account_email"
      required
      value="<%= typeof email !== 'undefined' ? email : '' %>"
    />

    <label for="password">Password:</label>
    <input
      type="password"
      id="password"
      name="account_password"
      required
      pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$"
    />
    <div class="form-note">
      There must be at least 12 characters, one must be a number, one must
      be a lowercase letter, one must be a capital letter, and one must be a
      non-alphanumeric character..
    </div>

    <div class="toggle-container">
      <input type="checkbox" id="togglePassword" />
      <label for="togglePassword">Show Password</label>
    </div>

    <button class="account-button" type="submit">Register</button>
  </form>
</div>

<script>
const toggle = document.getElementById("togglePassword");
const passwordField = document.getElementById("password");

toggle.addEventListener("change", () => {
  passwordField.type = toggle.checked ? "text" : "password";
});
</script>

