<div class="account-wrapper">
  <h1><%= title %></h1>

  <% if (flash && flash.notice && flash.notice.length > 0) { %>
  <div class="flash"><%= flash.notice[0] %></div>
  <% } %> <% if (errors) { %>
  <ul class="notice">
    <% errors.array().forEach(error => { %>
    <li class="data-error-message"><%= error.msg %></li>
    <% }) %>
  </ul>
  <% } %>

  <h2>Welcome <%= locals.accountData.account_firstname %>!</h2>
  <% if (locals.accountData.account_type == "Admin" ||
  locals.accountData.account_type == "Employee") { %>
  <h3>You have administrative privileges.</h3>
  <% } %>
  <div class="account-buttons">
    <p>
      <a
        href="/account/update/<%= locals.accountData.account_id %>"
        class="generic-button"
        >Update Account Info</a
      >
    </p>
    <% if (locals.accountData.account_type == "Admin" ||
    locals.accountData.account_type == "Employee") { %>
    <p><a class="generic-button" href="/inv">Manage Inventory</a></p>
    <% } %>
    <% if (locals.accountData.account_type == "Admin") { %>
    <p><a class="generic-button" href="/account/manage-accounts">Manage Accounts</a></p>
    <% } %>
  </div>
</div>
