<div class="account-wrapper">
  <h2>Account Update</h2>

  <% if (flash && flash.notice && flash.notice.length > 0) { %>
  <div class="flash"><%= flash.notice[0] %></div>
  <% if (flash && flash.problem && flash.problem.length > 0) { %>
  <div class="flash notice"><%= flash.problem[0] %></div>
  <% } %> <% } %> <% if (errors) { %>
  <ul class="notice">
    <% errors.array().forEach(error => { %>
    <li class="data-error-message"><%= error.msg %></li>
    <% }) %>
  </ul>
  <% } %> <%= accountData.account_firstName %>
  <form action="/account/update/<%= accountData.account_id %>" method="POST">
    <label for="account_firstname">First Name</label>
    <input
      type="text"
      id="account_firstname"
      name="account_firstname"
      value="<%= typeof req !== 'undefined' && req.body && req.body.account_firstname ? req.body.account_firstname : accountData.account_firstname %>"
      required
    />

    <label for="account_lastname">Last Name</label>
    <input
      type="text"
      id="account_lastname"
      name="account_lastname"
      value="<%= typeof req !== 'undefined' && req.body && req.body.account_lastname ? req.body.account_lastname : accountData.account_lastname %>"
      required
    />
    <label for="account_email">Email</label>
    <input
      type="email"
      id="account_email"
      name="account_email"
      value="<%= typeof req !== 'undefined' && req.body && req.body.account_email ? req.body.account_email : accountData.account_email %>"
      required
    />

    <button class="generic-button" type="submit">Update Account</button>

    <input
      type="text"
      name="account_id"
      value="<%= typeof req !== 'undefined' && req.body && req.body.account_id ? req.body.account_id : accountData.account_id %>"
      hidden
    />
  </form>
  <form
    action="/account/update-password/<%= accountData.account_id %>"
    method="POST"
  >
    <h2>Change Password</h2>
    <label for="current_password">Current Password</label>
    <input
      class="password-input"
      type="password"
      id="current_password"
      name="current_password"
      pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$"
      required
    />

    <label for="new_password">New Password</label>
    <input
      class="password-input"
      type="password"
      id="new_password"
      name="new_password"
      pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$"
      required
    />

    <input
      type="text"
      name="account_id"
      value="<%= typeof req !== 'undefined' && req.body && req.body.account_id ? req.body.account_id : accountData.account_id %>"
      hidden
    />

    <div class="form-note">
      By entering a password it will change your current password. There must be
      at least 12 characters, one must be a number, one must be a lowercase
      letter, one must be a capital letter, and one must be a non-alphanumeric
      character.
    </div>

    <button class="generic-button" type="submit">Change Password</button>
  </form>
</div>
