<header id="top-header">
  <span class="siteName">
    <a href="/" title="Return to home page">CSE Motors</a>
  </span>
  <div id="tools">
    <% if (locals.loggedin) { %>
    <div class="header-logout">
      <a href="/account" title="View your account"
        >Welcome <%= locals.accountData.account_firstname %></a
      >
      <a href="/account/logout" title="Log out">Logout</a>
    </div>
    <% } else { %>
    <a href="/account/login" title="Click to log in">My Account</a>
    <% } %>
  </div>
</header>