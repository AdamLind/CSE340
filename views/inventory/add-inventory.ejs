<div class="add-inventory-wrapper">
  <h1>Add New Vehicle</h1>

  <% try { %> <% if (flash && flash.notice && flash.notice.length > 0) { %>
  <div class="flash"><%= flash.notice[0] %></div>
  <% } %> <% if (errors && errors.length > 0) { %>
  <ul class="notice">
    <% errors.forEach(error => { %>
    <li class="data-error-message"><%= error.msg %></li>
    <% }) %>
  </ul>
  <% } %> <% } catch (e) { %>
  <p>Error rendering errors</p>
  <% } %>

  <form action="/inv/add-inventory" method="POST">
    <label for="classificationList">Classification</label>
    <%- classificationList %>
    <!-- Don't escape: allows raw HTML from utility -->

    <label for="inv_make">Make</label>
    <input
      type="text"
      id="inv_make"
      name="inv_make"
      required
      pattern="[A-Za-z0-9\s]+"
      value="<%= typeof inv_make !== 'undefined' ? inv_make : '' %>"
    />

    <label for="inv_model">Model</label>
    <input
      type="text"
      id="inv_model"
      name="inv_model"
      required
      pattern="[A-Za-z0-9\s]+"
      value="<%= typeof inv_model !== 'undefined' ? inv_model : '' %>"
    />

    <label for="inv_description">Description</label>
    <textarea id="inv_description" name="inv_description" required><%= typeof inv_description !== 'undefined' ? inv_description : '' %></textarea>

    <label for="inv_image">Image Path</label>
    <input
      type="text"
      id="inv_image"
      name="inv_image"
      required
      value="<%= typeof inv_image !== 'undefined' ? inv_image : '/images/vehicles/no-image.png' %>"
    />

    <label for="inv_thumbnail">Thumbnail Path</label>
    <input
      type="text"
      id="inv_thumbnail"
      name="inv_thumbnail"
      required
      value="<%= typeof inv_thumbnail !== 'undefined' ? inv_thumbnail : '/images/vehicles/no-image-tn.png' %>"
    />

    <label for="inv_price">Price</label>
    <input
      type="number"
      id="inv_price"
      name="inv_price"
      required
      step="0.01"
      value="<%= typeof inv_price !== 'undefined' ? inv_price : '' %>"
    />

    <label for="inv_year">Year</label>
    <input
      type="number"
      id="inv_year"
      name="inv_year"
      required
      min="1900"
      max="2100"
      value="<%= typeof inv_year !== 'undefined' ? inv_year : '' %>"
    />

    <label for="inv_miles">Mileage</label>
    <input
      type="number"
      id="inv_miles"
      name="inv_miles"
      required
      value="<%= typeof inv_miles !== 'undefined' ? inv_miles : '' %>"
    />

    <label for="inv_color">Color</label>
    <input
      type="text"
      id="inv_color"
      name="inv_color"
      required
      pattern="[A-Za-z\s]+"
      value="<%= typeof inv_color !== 'undefined' ? inv_color : '' %>"
    />

    <button type="submit">Add Vehicle</button>
  </form>
</div>
